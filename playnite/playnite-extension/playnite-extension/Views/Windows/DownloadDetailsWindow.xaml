<Window x:Class="GamesNexus.Views.DownloadDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Files to Install"
        Height="450" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="#CCFFFFFF"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0379FF" />
        <SolidColorBrush x:Key="CardBg" Color="#14FFFFFF" />
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select files to include in the installation:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

        <ListBox x:Name="FileListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Visible">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,2" Padding="8,4" CornerRadius="8" Background="#14FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <TextBlock Text="{Binding Name}" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding LengthDisplay}" FontSize="12" Foreground="#99FFFFFF" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button x:Name="SelectAllBtn" Click="SelectAll_Click" Style="{StaticResource ActionBtn}" Content="Select All" Margin="0,0,8,0" />
            <Button x:Name="DeselectAllBtn" Click="DeselectAll_Click" Style="{StaticResource ActionBtn}" Content="Deselect All" Margin="0,0,8,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
             <Button x:Name="ConfirmBtn" Click="Confirm_Click" Style="{StaticResource ActionBtn}" Background="{StaticResource AccentBrush}" Foreground="White" Content="Confirm Selection" Margin="0,0,8,0" />
            <Button x:Name="CancelBtn" Click="Cancel_Click" Style="{StaticResource ActionBtn}" Content="Cancel" />
        </StackPanel>
    </Grid>
</Window>
