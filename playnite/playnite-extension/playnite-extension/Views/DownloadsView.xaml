<UserControl x:Class="GamesNexus.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xef08;" FontFamily="{DynamicResource FontIcoFont}" FontSize="24" Foreground="White" VerticalAlignment="Center" Margin="0,-2,8,0" />
                <TextBlock Text="Downloads" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
            <Button Click="RefreshDownloads_Click" Style="{DynamicResource FxActionBtn}" Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xefd1;" FontFamily="{DynamicResource FontIcoFont}" Margin="0,-2,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Refresh" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Active Downloads" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ItemsControl x:Name="DownloadsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Margin="0,4" Background="{DynamicResource FxCardBg}" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusName}" Foreground="{DynamicResource FxAccent}" FontSize="13" VerticalAlignment="Center" />
                                    </Grid>
                                    <ProgressBar Grid.Row="1" Value="{Binding Progress, Mode=OneWay}" Height="8" Maximum="100" BorderThickness="0" Background="{DynamicResource FxCardBg}" Foreground="{DynamicResource FxAccent}" Margin="0,8" />
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding SpeedDisplay}" Foreground="{DynamicResource FxTextSubtle}" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding PeersDisplay, StringFormat='Peers: {0}'}" Foreground="{DynamicResource FxTextSubtle}" FontSize="12" Margin="16,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding EtaDisplay, StringFormat='ETA: {0}'}" Foreground="{DynamicResource FxTextSubtle}" FontSize="12" Margin="16,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding ProgressDisplay}" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="16,0" />
                                    </Grid>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="Play" Tag="{Binding}" Click="DownloadPlay_Click" Style="{DynamicResource FxActionBtn}" FontSize="12" Padding="8,4" />
                                        <Button Content="Pause" Tag="{Binding}" Click="DownloadPause_Click" Style="{DynamicResource FxActionBtn}" FontSize="12" Padding="8,4" />
                                        <Button Content="Remove" Tag="{Binding}" Click="DownloadRemove_Click" Style="{DynamicResource FxActionBtn}" FontSize="12" Padding="8,4" />
                                            </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Installing" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,8" />
                <ItemsControl x:Name="InstallsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Margin="0,4" Background="{DynamicResource FxCardBg}" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                                    <ProgressBar Grid.Row="1" Value="{Binding Progress, Mode=OneWay}" Height="8" Maximum="100" BorderThickness="0" Background="{DynamicResource FxCardBg}" Foreground="{DynamicResource FxWarning}" Margin="0,8" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Completed Downloads" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,8" />
                <ItemsControl x:Name="CompletedDownloadsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Margin="0,4" Background="{DynamicResource FxCardBg}" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="White" FontSize="16" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Click="InstallFromCompleted_Click" Tag="{Binding}" Style="{DynamicResource FxActionBtn}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xec74;" FontFamily="{DynamicResource FontIcoFont}" Margin="0,-2,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Install" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>