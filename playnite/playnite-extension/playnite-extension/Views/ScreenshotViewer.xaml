<UserControl x:Class="GamesNexus.Views.ScreenshotViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" PreviewKeyDown="ScreenshotViewer_PreviewKeyDown">
    <Border x:Name="ScreenshotOverlay" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="100">
        <Grid>
            <Button Style="{DynamicResource FxActionBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,16,0" Width="48" Height="48" Click="ScreenshotViewer_Close">
                <TextBlock Text="✕"  FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="ScreenshotViewerPrev" Style="{DynamicResource FxActionBtn}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16" Width="64" Height="64" Click="ScreenshotViewer_Prev" IsEnabled="False">
                <TextBlock Text="◄"  FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button  x:Name="ScreenshotViewerNext" Style="{DynamicResource FxActionBtn}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16" Width="64" Height="64" Click="ScreenshotViewer_Next" IsEnabled="False">
                <TextBlock Text="►"  FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <TextBlock x:Name="ScreenshotViewerCounter" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Foreground="White" FontSize="14" />
            <Border Panel.ZIndex="-1" Background="Transparent" Margin="0,0" ClipToBounds="True">
                <Image x:Name="ScreenshotViewerImage" Stretch="Uniform" RenderTransformOrigin="0,0" Cursor="Hand"
                       MouseWheel="ScreenshotViewer_MouseWheel"
                       MouseLeftButtonDown="ScreenshotViewer_MouseDown"
                       MouseLeftButtonUp="ScreenshotViewer_MouseUp"
                       MouseMove="ScreenshotViewer_MouseMove">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ScreenshotViewerScale" />
                            <TranslateTransform x:Name="ScreenshotViewerTranslate" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Border>
        </Grid>
    </Border>
</UserControl>