<UserControl x:Class="GamesNexus.Views.Controls.RepackSelectorControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:GamesNexus.Models">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ComboBox x:Name="RepackCombo" Grid.Column="0" Background="#0AFFFFFF" Foreground="White" BorderThickness="0" Margin="0,0,4,0" Height="54" SelectionChanged="RepackCombo_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:Repack}">
                    <StackPanel Margin="4,4">
                        <!-- Top Row: Source Badge & Title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#0379FF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Source.Title, FallbackValue='Unknown'}" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="280" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Bottom Row: Size, Date, and Link Types -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FileSize, StringFormat='Size: {0}'}" FontSize="11" Foreground="#99FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center" />

                            <!-- Simple date display (Assuming UploadDate is a string format like YYYY-MM-DD) -->
                            <TextBlock Text="{Binding UploadDate}" FontSize="11" Foreground="#99FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center" />

                            <!-- Dynamic badges for Download Types (Magnet / Torrent / Direct) -->
                            <ItemsControl ItemsSource="{Binding UrisList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#33FFFFFF" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding Type}" FontSize="9" Foreground="#E6FFFFFF" TextWrapping="NoWrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Button x:Name="DownloadBtn" Grid.Column="1" Click="DownloadBtn_Click" Style="{DynamicResource FxActionBtn}" Background="#0379FF" Foreground="White" IsEnabled="False" Height="54" Padding="16,0" Margin="4,0,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE896;" FontFamily="{DynamicResource FontIcoFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="DownloadBtnText" Text="Download" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>