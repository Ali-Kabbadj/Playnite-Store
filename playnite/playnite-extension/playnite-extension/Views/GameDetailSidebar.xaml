<UserControl x:Class="GamesNexus.Views.GameDetailSidebar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:GamesNexus.Converters" xmlns:controls="clr-namespace:GamesNexus.Views.Controls">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <FontFamily x:Key="FontIcoFont">Segoe MDL2 Assets</FontFamily>
        <Style x:Key="FxActionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3DFFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="SidebarRoot" Background="Transparent" ClipToBounds="True" Visibility="Collapsed" Margin="0,0,0,0">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button x:Name="SidebarCloseBtn" Click="SidebarClose_Click" Style="{DynamicResource FxActionBtn}" HorizontalAlignment="Left" Width="36" Height="36" Padding="0" Background="#66000000">
                <TextBlock Text="&#xE711;" FontFamily="{DynamicResource FontIcoFont}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Button>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="120" Height="170" CornerRadius="12" Margin="0,0,16,0" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Border.Clip>
                                <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,120,170" />
                            </Border.Clip>
                            <Image x:Name="SidebarCoverImage" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <Border x:Name="SidebarRepackDateBadge" Background="#FFD600" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="Collapsed">
                                <TextBlock x:Name="SidebarRepackDate" Foreground="Black" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <TextBlock x:Name="SidebarTitle" FontSize="26" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock x:Name="SidebarDeveloper" Foreground="#99FFFFFF" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock x:Name="SidebarReleaseDate" Foreground="#99FFFFFF" FontSize="13" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel x:Name="SidebarGenresPanel" Margin="0,0,0,16" Visibility="Collapsed" />
                    <Border x:Name="SidebarRepackSection" Background="#1AFFFFFF" CornerRadius="12" Padding="12" Margin="0,0,0,16" Visibility="Collapsed" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="SidebarRepackHeader" Text="Available Repacks" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <controls:RepackSelectorControl x:Name="RepackSelector" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="About this game" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock x:Name="SidebarDescription" TextWrapping="Wrap" Foreground="#CCFFFFFF" FontSize="13" LineHeight="20" Margin="0,0,0,24" />
                    <Border x:Name="SidebarScreenshotSection" Visibility="Collapsed" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Media" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="SidebarScreenshotPanel" Orientation="Horizontal" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>