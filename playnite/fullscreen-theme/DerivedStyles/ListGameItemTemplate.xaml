<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d">
    <Style x:Key="ListGameItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Grid>
                        <Border x:Name="Mask" Background="Black" BorderThickness="0" CornerRadius="10" />
                        <Image x:Name="PART_ImageCover" RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both" Stretch="{Settings CoverArtStretch}" />
                        <!-- NEW: Metadata Overlay (Platform, Age, Score, Year) -->
                        <Border VerticalAlignment="Bottom" Background="#CC000000" CornerRadius="0,0,10,10" Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Platform -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Age Rating -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Spacer -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Critic Score -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Year -->
                                </Grid.ColumnDefinitions>
                                <!-- Platform -->
                                <Image Grid.Column="0" HorizontalAlignment="Left" MaxHeight="16" RenderOptions.BitmapScalingMode="Fant" Source="{ThemeFileBinding Game.Platforms.[0].Name, PathFormat='Icons/Platform/{0}.png'}" Margin="0,0,8,0" />
                                <!-- Age Rating -->
                                <ItemsControlEx Grid.Column="1" ItemsSource="{Binding Game.AgeRatings}" MaxHeight="16" VerticalAlignment="Center" Focusable="False">
                                    <ItemsControlEx.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControlEx.ItemsPanel>
                                    <ItemsControlEx.ItemTemplate>
                                        <DataTemplate>
                                            <Image MaxHeight="16" Source="{ThemeFileBinding Name, PathFormat='Icons/AgeRating/{0}.png'}" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="Fant" />
                                        </DataTemplate>
                                    </ItemsControlEx.ItemTemplate>
                                </ItemsControlEx>
                                <!-- Critic Score -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Game.CriticScore}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="★" Foreground="#FFD700" FontSize="16" VerticalAlignment="Center" Margin="0,0,3,1" />
                                    <TextBlock Text="{Binding Game.CriticScore}" Foreground="White" FontSize="14" FontFamily="Lato Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- Year -->
                                <TextBlock Grid.Column="4" HorizontalAlignment="Right" Text="{Binding Game.ReleaseYear}" Foreground="White" FontSize="14" FontFamily="Lato Bold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Canvas x:Name="Playing" Visibility="Collapsed">
                            <Polygon Points="0,0 50,0 0,50" Fill="#FFB32B" Opacity="1" />
                        </Canvas>
                        <Border Background="#A0000000" x:Name="BorderDarken" CornerRadius="10" Visibility="Collapsed" />
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" Style="{DynamicResource TextBlockBaseStyle}" FontSize="{DynamicResource FontSizeSmall}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" TextAlignment="Center" Padding="5" Background="{DynamicResource ControlBackgroundDarkBrush}" />
                        <Grid.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=Mask}" RenderOptions.BitmapScalingMode="Fant" Stretch="Fill" />
                        </Grid.OpacityMask>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings Fullscreen.DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderDarken" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding CompletionStatus.Name}" Value="Playing">
                            <Setter Property="Visibility" Value="Visible" TargetName="Playing" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>