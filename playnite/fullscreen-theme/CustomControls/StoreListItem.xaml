<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="StoreListGameItemTemplate">
        <Grid>
            <Border x:Name="Mask" Background="Black" BorderThickness="0" CornerRadius="10" />
            <Image x:Name="PART_ImageCover" RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both" Stretch="{Settings CoverArtStretch}" Source="{Binding CoverImageBitmap}" />

            <!-- 1:1 Native Metadata Overlay -->
            <Border VerticalAlignment="Bottom" Background="#CC000000" CornerRadius="0,0,10,10" Padding="8,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" HorizontalAlignment="Left" MaxHeight="16" RenderOptions.BitmapScalingMode="Fant" Source="{Binding PlatformIcon}" Margin="0,0,8,0">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPlatformIcon}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rating}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="★" Foreground="#FFD700" FontSize="16" VerticalAlignment="Center" Margin="0,0,3,1" />
                        <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}" Foreground="White" FontSize="14" FontFamily="Lato Bold" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="4" HorizontalAlignment="Right" Text="{Binding ReleaseYearLabel}" Foreground="White" FontSize="14" FontFamily="Lato Bold" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Repack Tag -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Background="#FFD600" CornerRadius="0,10,0,5" Padding="6,2" Margin="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Repacks.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Repacks}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="Repack" Foreground="Black" FontSize="11" FontWeight="Bold" />
            </Border>

            <Grid.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=Mask}" RenderOptions.BitmapScalingMode="Fant" Stretch="Fill" />
            </Grid.OpacityMask>
        </Grid>
    </DataTemplate>
</ResourceDictionary>