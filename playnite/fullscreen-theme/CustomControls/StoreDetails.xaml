<?xml version="1.0" encoding="UTF-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="StoreDetailsTemplate" TargetType="ContentControl">
        <StackPanel Orientation="Vertical">

            <StackPanel MaxWidth="800" Margin="0,50,0,0" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Content.SelectedGame.DisplayName, ElementName=StoreDataBridge}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Style="{DynamicResource TextBlockBoldBaseStyle}" FontSize="46" MaxHeight="120" TextAlignment="Left" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Left">
                <!-- Native-style Metadata row elements -->
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" Visibility="{Binding Content.SelectedGame.HasPlatformIcon, ElementName=StoreDataBridge, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Image MaxHeight="30" RenderOptions.BitmapScalingMode="Fant" Source="{Binding Content.SelectedGame.PlatformIcon, ElementName=StoreDataBridge}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" Visibility="{Binding Content.SelectedGame.HasPublisherBadge, ElementName=StoreDataBridge, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding Content.SelectedGame.PublisherBadge, ElementName=StoreDataBridge}" Foreground="#BFEAD3CF" FontSize="20" VerticalAlignment="Center" FontFamily="Lato Bold" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <Border MaxHeight="30" Background="#AA000000" BorderBrush="{DynamicResource TextAltBrush}" BorderThickness="2" CornerRadius="5">
                        <TextBlock Margin="3,2,3,0" FontSize="20" Style="{DynamicResource TextBlockBaseStyleAlt}" Text="{Binding Content.SelectedGame.ReleaseYearLabel, ElementName=StoreDataBridge}" TextAlignment="Center" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding Content.SelectedGame.Summary, ElementName=StoreDataBridge}" TextWrapping="Wrap" Foreground="#DDD" FontSize="18" FontFamily="Lato Bold" LineHeight="24" MaxHeight="96" Margin="20,20,0,0" TextTrimming="WordEllipsis" MaxWidth="800" HorizontalAlignment="Left" />

            <Grid Margin="0,40,0,0" HorizontalAlignment="Left">
                <ButtonEx Command="{Binding Content.StartDownloadCommand, ElementName=StoreDataBridge}" CommandParameter="{Binding Content.SelectedGame, ElementName=StoreDataBridge}" Margin="20,0,20,0" Height="50" MinWidth="240" HorizontalContentAlignment="Center" Style="{DynamicResource ButtonInstall}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xef08;" FontFamily="{StaticResource FontIcoFont}" FontSize="30" Foreground="{DynamicResource TextAltBrush}" TextAlignment="Center" Margin="0,6,10,0" />
                        <TextBlock Text="DOWNLOAD" Foreground="White" FontSize="24" FontWeight="SemiBold" FontFamily="Lato Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </ButtonEx>
            </Grid>
        </StackPanel>
    </ControlTemplate>
</ResourceDictionary>