<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
    mc:Ignorable="d">
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style TargetType="{x:Type Main}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Main}">
                    <Grid
                        x:Name="PART_MainHost"
                        d:DataContext="{x:Static DesignMainViewModel.DesignIntance}"
                        d:DesignHeight="{StaticResource DesignHeight}"
                        d:DesignWidth="{StaticResource DesignWidth}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="{DynamicResource MainBackgroundBrush}" />
                            </Style>
                        </Grid.Style>

                        <Grid
                            x:Name="BackgroundImageGrid"
                            Grid.RowSpan="2"
                            Panel.ZIndex="-46"
                            FocusVisualStyle="{x:Null}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Opacity" Value="0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid x:Name="BackgroundImageContainer">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=TrailerToggle, Path=IsChecked}" Value="True" />
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=IsActive}" Value="True" />
                                                    <Condition Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsVideoPlaying}" Value="True" />
                                                    <Condition Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="0"
                                                                Duration="0:0:0.5" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="1"
                                                                Duration="0:0:0.3" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!--  Native Game Background  -->
                                <FadeImage
                                    x:Name="CustomBackgroundImage"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    RenderOptions.BitmapScalingMode="Fant"
                                    Source="{Binding SelectedGame.BackgroundImage}"
                                    Stretch="UniformToFill">
                                    <FadeImage.Style>
                                        <Style TargetType="FadeImage">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </FadeImage.Style>
                                </FadeImage>

                                <!--  GamesNexus Game Background  -->
                                <FadeImage
                                    x:Name="StoreBackgroundImage"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    RenderOptions.BitmapScalingMode="Fant"
                                    Source="{Binding Content.CurrentHeroImage, ElementName=StoreDataBridge}"
                                    Stretch="UniformToFill">
                                    <FadeImage.Style>
                                        <Style TargetType="FadeImage">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </FadeImage.Style>
                                </FadeImage>

                                <!--  Native Soft Left-to-Right Gradient Dimming  -->
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Offset="0" Color="#E5000000" />
                                            <GradientStop Offset="0.3" Color="#A0000000" />
                                            <GradientStop Offset="1" Color="#22000000" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>

                            <TextBlock
                                Name="VideoPathTrailer"
                                Tag="{DynamicResource ExtraMetadataPath}"
                                Visibility="Collapsed">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}{0}{1}{2}{3}">
                                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                                    <Binding Source="\ExtraMetadata\games\" />
                                                    <Binding Path="SelectedGame.Id" />
                                                    <Binding Source="\VideoTrailer.mp4" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Grid x:Name="VideoContainer">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Opacity" Value="0" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=TrailerToggle, Path=IsChecked}" Value="True" />
                                                    <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=IsActive}" Value="True" />
                                                    <Condition Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="1"
                                                                Duration="0:0:0.3" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="0"
                                                                Duration="0:0:0.3" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <MediaElement
                                    x:Name="VideoSourceBackgrounds"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    MediaElementBehaviors.Repeat="True"
                                    RenderOptions.BitmapScalingMode="Fant"
                                    Stretch="UniformToFill"
                                    Volume="{Settings Fullscreen.BackgroundVolume}">
                                    <MediaElement.CacheMode>
                                        <BitmapCache RenderAtScale="1" />
                                    </MediaElement.CacheMode>
                                    <MediaElement.Style>
                                        <Style TargetType="MediaElement">
                                            <Setter Property="MediaElement.Source" Value="{Binding ElementName=VideoPathTrailer, Path=Text, NotifyOnTargetUpdated=True}" />
                                            <Setter Property="LoadedBehavior" Value="Play" />
                                            <Setter Property="UnloadedBehavior" Value="Stop" />
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                    <BeginStoryboard Name="ResetVideo">
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="0"
                                                                Duration="0" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="MediaElement.MediaOpened">
                                                    <BeginStoryboard Name="FadeVideoIn">
                                                        <Storyboard FillBehavior="HoldEnd">
                                                            <DoubleAnimation
                                                                BeginTime="0:0:1"
                                                                Storyboard.TargetProperty="Opacity"
                                                                From="0"
                                                                To="1"
                                                                Duration="0:0:0.5" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <Trigger Property="Opacity" Value="0">
                                                    <Setter Property="LoadedBehavior" Value="Pause" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=IsActive}" Value="False">
                                                    <Setter Property="LoadedBehavior" Value="Pause" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=TrailerToggle, Path=IsChecked}" Value="False">
                                                    <Setter Property="LoadedBehavior" Value="Pause" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True">
                                                    <Setter Property="LoadedBehavior" Value="Pause" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MediaElement.Style>
                                </MediaElement>
                            </Grid>
                        </Grid>

                        <!--  Main view  -->
                        <Grid
                            x:Name="PART_ViewHost"
                            Grid.Row="1"
                            Background="Transparent">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="Visibility" Value="Visible" />
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="350" />
                                <RowDefinition Height="60" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1280" />
                            </Grid.ColumnDefinitions>

                            <!--  GLOBAL TOP BAR  -->
                            <Grid Panel.ZIndex="1" FocusVisualStyle="{x:Null}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Grid.Row" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="3" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=PART_MainHost, Path=Visibility}" Value="Visible">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                BeginTime="0:0:1"
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="1"
                                                                Duration="0:0:0.5" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <Rectangle
                                    Width="{Binding ActualWidth, ElementName=PART_ViewHost}"
                                    Height="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Bottom"
                                    Fill="{DynamicResource TextAltBrush}"
                                    Opacity="0.4">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Grid.ColumnSpan" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>

                                <ButtonEx
                                    x:Name="PART_ButtonMainMenu"
                                    Grid.Column="1"
                                    Width="50"
                                    Height="50"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{DynamicResource ButtonMenu}">
                                    <ButtonEx.Content>
                                        <Image
                                            Width="32"
                                            Height="32"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RenderOptions.BitmapScalingMode="Fant"
                                            Source="{ThemeFile 'Icons/UI/menu.png'}" />
                                    </ButtonEx.Content>
                                </ButtonEx>

                                <CheckBoxEx
                                    x:Name="ChangeViewButton"
                                    Grid.Column="2"
                                    Width="50"
                                    Height="50"
                                    Margin="10,0,0,0"
                                    IsChecked="{Settings Fullscreen.HorizontalLayout,
                                                         Mode=TwoWay}"
                                    Style="{DynamicResource ChangeViewButton}" />

                                <!--  GAMES NEXUS STORE BRIDGE & TOGGLE BUTTON  -->
                                <ContentControl
                                    x:Name="StoreDataBridge"
                                    Content="{DynamicResource GamesNexusCatalog}"
                                    Visibility="Collapsed" />

                                <!--  Switch view: library | store  -->
                                <CheckBoxEx
                                    x:Name="ToggleStoreButton"
                                    Grid.Column="3"
                                    Width="100"
                                    Height="50"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FocusVisualStyle="{x:Null}"
                                    IsChecked="{Binding Content.IsStoreOpen, ElementName=StoreDataBridge, Mode=TwoWay}"
                                    OverridesDefaultStyle="True"
                                    Style="{x:Null}">
                                    <CheckBoxEx.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Grid
                                                Width="100"
                                                Height="50"
                                                Background="Transparent"
                                                Cursor="Hand">
                                                <Border
                                                    Margin="5"
                                                    Background="{DynamicResource ControlBackgroundBrush}"
                                                    CornerRadius="25"
                                                    Opacity="0.45" />

                                                <Border
                                                    x:Name="Slider"
                                                    Width="40"
                                                    Height="40"
                                                    Margin="5"
                                                    HorizontalAlignment="Left"
                                                    Background="White"
                                                    CornerRadius="20">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="SliderTransform" />
                                                    </Border.RenderTransform>
                                                </Border>

                                                <TextBlock
                                                    x:Name="LibraryIcon"
                                                    Width="50"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource FontIcoFont}"
                                                    FontSize="22"
                                                    Foreground="#AAFFFFFF"
                                                    Text="🕮"
                                                    TextAlignment="Center" />

                                                <TextBlock
                                                    x:Name="StoreIcon"
                                                    Width="50"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource FontIcoFont}"
                                                    FontSize="22"
                                                    Foreground="#AAFFFFFF"
                                                    Text="🛒"
                                                    TextAlignment="Center" />

                                                <Border
                                                    x:Name="FocusBorder"
                                                    Width="100"
                                                    Height="50"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="3"
                                                    CornerRadius="25"
                                                    IsHitTestVisible="False"
                                                    SnapsToDevicePixels="True" />

                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CheckStates">
                                                        <VisualState x:Name="Checked">
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetName="SliderTransform"
                                                                    Storyboard.TargetProperty="X"
                                                                    To="50"
                                                                    Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Unchecked">
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetName="SliderTransform"
                                                                    Storyboard.TargetProperty="X"
                                                                    To="0"
                                                                    Duration="0:0:0.15">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="FocusBorder" Property="BorderBrush" Value="#88FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="LibraryIcon" Property="Foreground" Value="#55FFFFFF" />
                                                    <Setter TargetName="StoreIcon" Property="Foreground" Value="#FF000000" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter TargetName="LibraryIcon" Property="Foreground" Value="#FF000000" />
                                                    <Setter TargetName="StoreIcon" Property="Foreground" Value="#55FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBoxEx.Template>
                                </CheckBoxEx>
                                <!--  Store Inline Search & Loader  -->
                                <StackPanel
                                    Grid.Column="3"
                                    Margin="250,0,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <!--  Slide up animation  -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=Store_Id, Path=Opacity}" Value="1" />
                                                        <Condition Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ThicknessAnimation
                                                                    BeginTime="0:0:0.5"
                                                                    Storyboard.TargetProperty="Margin"
                                                                    From="80,100,0,0"
                                                                    Duration="0:0:0.7">
                                                                    <ThicknessAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </ThicknessAnimation.EasingFunction>
                                                                </ThicknessAnimation>
                                                                <DoubleAnimation
                                                                    BeginTime="0:0:0.5"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="1"
                                                                    Duration="0:0:0.7" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ThicknessAnimation
                                                                    Storyboard.TargetProperty="Margin"
                                                                    To="80,0,0,0"
                                                                    Duration="0:0:0">
                                                                    <ThicknessAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </ThicknessAnimation.EasingFunction>
                                                                </ThicknessAnimation>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="0"
                                                                    Duration="0:0:0" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>

                                                <!--  SAFE NULL CHECK (Prevents XAML Crash)  -->
                                                <DataTrigger Binding="{Binding Content.SelectedGame, ElementName=StoreDataBridge}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Border
                                        Height="40"
                                        Margin="0,0,10,0"
                                        Padding="15,0"
                                        Background="{DynamicResource ControlBackgroundBrush}"
                                        CornerRadius="20"
                                        Opacity="0.8">
                                        <TextBox
                                            Width="200"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="20"
                                            Foreground="White"
                                            Text="{Binding Content.SearchText, ElementName=StoreDataBridge, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                            Visibility="Collapsed" />
                                    </Border>
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Foreground="White"
                                        Text="Loading...">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Content.IsLoading, ElementName=StoreDataBridge}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!--  Top Menu Icons  -->
                                <ButtonEx Grid.Column="6" Command="{PluginSettings Plugin=NowPlaying, Path=OpenDialog}">
                                    <ButtonEx.Style>
                                        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="ButtonEx">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Margin" Value="0,0,48,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginStatus Plugin=NowPlaying_db4e7ade-57fb-426c-8392-60e2347a0209, Status=Installed}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{PluginSettings Plugin=NowPlaying, Path=IsGameRunning}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ButtonEx.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="40"
                                            Height="40"
                                            Source="{PluginSettings Plugin=NowPlaying,
                                                                    Path=RunningGame.IconPath}"
                                            Style="{DynamicResource NowPlayingImageStyle}" />
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock
                                                x:Name="NowPlaying_Title"
                                                Style="{DynamicResource NowPlayingTitleStyle}"
                                                Text="NOW PLAYING" />
                                            <TextBlock
                                                x:Name="NowPlaying_Game"
                                                Style="{DynamicResource NowPlayingGameStyle}"
                                                Text="{PluginSettings Plugin=NowPlaying,
                                                                      Path=RunningGame.GameName}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ButtonEx>
                                <ButtonEx
                                    x:Name="PART_ButtonProgramUpdate"
                                    Grid.Column="7"
                                    Width="50"
                                    Height="50"
                                    Margin="48,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{DynamicResource ButtonMenu}">
                                    <ButtonEx.Content>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource FontIcoFont}"
                                            FontSize="32"
                                            Foreground="#ff6b6b"
                                            Text="?" />
                                    </ButtonEx.Content>
                                </ButtonEx>
                                <ButtonEx
                                    x:Name="PART_ButtonNotifications"
                                    Grid.Column="8"
                                    Width="50"
                                    Height="50"
                                    Margin="48,0,0,0"
                                    VerticalAlignment="Center"
                                    Focusable="True">
                                    <Button.Content>
                                        <Grid>
                                            <Image
                                                Width="32"
                                                Height="32"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                RenderOptions.BitmapScalingMode="Fant"
                                                Source="{ThemeFile 'Icons/UI/notification.png'}" />
                                            <Ellipse
                                                Width="12"
                                                Height="12"
                                                Margin="18,18,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Fill="{DynamicResource GlyphBrush}"
                                                Stroke="{DynamicResource MainBackgroundBrush}"
                                                StrokeThickness="2" />
                                        </Grid>
                                    </Button.Content>
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource ButtonMenu}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </ButtonEx>
                                <Grid Grid.Column="9" Margin="48,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl
                                        x:Name="PART_ElemBatteryStatus"
                                        Grid.Column="0"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        Focusable="False"
                                        FontSize="1"
                                        Opacity="0">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Critical">
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusCritical}" />
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Low">
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusLow}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Medium">
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusMedium}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="High">
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusHigh}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PowerStatus.IsCharging}" Value="True">
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusCharging}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Grid.Column" Value="0" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=PART_ElemBatteryStatus, Path=Visibility}" Value="Visible">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Image
                                            Height="22"
                                            RenderOptions.BitmapScalingMode="Fant"
                                            Source="{ThemeFile 'Images/Battery_Critical.png'}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Critical">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Image
                                            Height="22"
                                            RenderOptions.BitmapScalingMode="Fant"
                                            Source="{ThemeFile 'Images/Battery_Low.png'}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Low">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Image
                                            Height="22"
                                            RenderOptions.BitmapScalingMode="Fant"
                                            Source="{ThemeFile 'Images/Battery_Medium.png'}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Medium">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Image
                                            Height="22"
                                            RenderOptions.BitmapScalingMode="Fant"
                                            Source="{ThemeFile 'Images/Battery_Full.png'}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="High">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Image
                                            Height="22"
                                            RenderOptions.BitmapScalingMode="Fant"
                                            Source="{ThemeFile 'Images/Battery_Charging.png'}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PowerStatus.IsCharging}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="PART_TextBatteryPercentage"
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{DynamicResource TextBlockBaseStyleAlt}" />
                                    <Grid.Effect>
                                        <DropShadowEffect
                                            BlurRadius="0"
                                            Opacity="0.8"
                                            RenderingBias="Quality"
                                            ShadowDepth="1"
                                            Color="Black" />
                                    </Grid.Effect>
                                </Grid>
                                <TextBlock
                                    x:Name="PART_TextClock"
                                    Grid.Column="10"
                                    Margin="45,5,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="30"
                                    Style="{DynamicResource TextBlockBaseStyleAlt}">
                                    <TextBlock.Effect>
                                        <DropShadowEffect
                                            BlurRadius="0"
                                            Opacity="0.8"
                                            RenderingBias="Quality"
                                            ShadowDepth="1"
                                            Color="Black" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>

                            <!--  NATIVE GAME DETAILS  -->
                            <Grid
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Panel.ZIndex="-45">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <!--  LogoContainer  -->
                                <StackPanel x:Name="LogoContainer" Orientation="Vertical">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="0" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Margin" Value="80,0,0,0" />
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=Id, Path=Opacity}" Value="1">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=Id, Path=Opacity}" Value="1" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ThicknessAnimation
                                                                    BeginTime="0:0:0.5"
                                                                    Storyboard.TargetProperty="Margin"
                                                                    From="80,100,0,0"
                                                                    Duration="0:0:0.7">
                                                                    <ThicknessAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </ThicknessAnimation.EasingFunction>
                                                                </ThicknessAnimation>
                                                                <DoubleAnimation
                                                                    BeginTime="0:0:0.5"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="1"
                                                                    Duration="0:0:0.7" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ThicknessAnimation
                                                                    Storyboard.TargetProperty="Margin"
                                                                    To="80,0,0,0"
                                                                    Duration="0:0:0">
                                                                    <ThicknessAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </ThicknessAnimation.EasingFunction>
                                                                </ThicknessAnimation>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="0"
                                                                    Duration="0:0:0" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <StackPanel>
                                        <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="MaxWidth" Value="600" />
                                                    <Setter Property="MaxHeight" Value="350" />
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=LogoTrigger, Path=Opacity}" Value="1">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <Image Source="{Binding SelectedGame.IconObject}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Margin" Value="0,0,0,50" />
                                                    <Setter Property="MaxWidth" Value="180" />
                                                    <Setter Property="MaxHeight" Value="180" />
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Setter Property="VerticalAlignment" Value="Bottom" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Source}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </StackPanel>
                                    <StackPanel x:Name="AdditionalGameTitlePanel" MaxWidth="800">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Opacity" Value="0" />
                                                <Setter Property="Margin" Value="0,50,0,0" />
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=Id, Path=Opacity}" Value="1" />
                                                        </MultiDataTrigger.Conditions>
                                                        <MultiDataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        BeginTime="0:0:0.6"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="1"
                                                                        Duration="0:0:1" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.EnterActions>
                                                        <MultiDataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0"
                                                                        Duration="0:0:0" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.ExitActions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=ExtraMetadataLoader, Path=IsLogoAvailable}" Value="True">
                                                        <Setter Property="Margin" Value="0,0,0,0" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock
                                            MaxHeight="120"
                                            FontSize="46"
                                            Style="{DynamicResource TextBlockBoldBaseStyle}"
                                            Text="{Binding SelectedGame.DisplayName}"
                                            TextAlignment="Left"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel x:Name="AdditionalGameDetailsPanel" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Opacity" Value="0" />
                                                <Setter Property="Margin" Value="0,10,0,0" />
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=Id, Path=Opacity}" Value="1" />
                                                        </MultiDataTrigger.Conditions>
                                                        <MultiDataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        BeginTime="0:0:0.6"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="1"
                                                                        Duration="0:0:1" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.EnterActions>
                                                        <MultiDataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0"
                                                                        Duration="0:0:0" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </MultiDataTrigger.ExitActions>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <StackPanel Margin="20,0,0,0" Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedGame.Library}" Value="Playnite">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Image
                                                x:Name="LibraryIcon"
                                                MaxHeight="30"
                                                RenderOptions.BitmapScalingMode="Fant"
                                                Source="{ThemeFileBinding SelectedGame.Library,
                                                                          PathFormat='Icons/Library/{0}.png'}" />
                                        </StackPanel>
                                        <StackPanel
                                            Margin="20,0,0,0"
                                            Orientation="Horizontal"
                                            Visibility="Collapsed">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=PlatformIcon, Path=Source}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Image
                                                x:Name="PlatformIcon"
                                                MaxHeight="30"
                                                RenderOptions.BitmapScalingMode="Fant"
                                                Source="{ThemeFileBinding SelectedGame.Platforms.[0].Name,
                                                                          PathFormat='Icons/Platform/{0}.png'}" />
                                        </StackPanel>
                                        <StackPanel Margin="20,0,0,0" Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedGame.Favorite}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedGame.Platforms.Name}" Value="{x:Null}">
                                                            <Setter Property="Margin" Value="0,0,0,0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock
                                                x:Name="FavoriteFont"
                                                FontFamily="{StaticResource FontIcoFont}"
                                                FontSize="32"
                                                Foreground="{DynamicResource FavoriteBrush}"
                                                Text="?"
                                                TextAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Margin="20,0,0,0" Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedGame.IsInstalled}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding SelectedGame.IsInstalled}" Value="False" />
                                                                <Condition Binding="{Settings Fullscreen.DarkenUninstalledGamesGrid}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ElementName=PART_ButtonInstall, Path=Visibility}" Value="Visible">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock
                                                x:Name="InstallFont"
                                                FontFamily="{StaticResource FontIcoFont}"
                                                FontSize="32"
                                                Foreground="{DynamicResource InstallButtonBackgroundBrush}"
                                                Text="?"
                                                TextAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel
                                            Margin="20,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Visibility="Collapsed">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedGame.CriticScore}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border
                                                Width="34"
                                                Height="34"
                                                Background="{Binding Foreground, ElementName=CriticScoreBackground}"
                                                BorderBrush="{DynamicResource TextAltBrush}"
                                                BorderThickness="0"
                                                CornerRadius="5">
                                                <TextBlock
                                                    x:Name="CriticScoreBackground"
                                                    Margin="0,5,0,0"
                                                    FontSize="1"
                                                    Style="{DynamicResource TextBlockGameScore}"
                                                    Text="{Binding SelectedGame.CriticScore}"
                                                    TextAlignment="Center"
                                                    Visibility="Hidden" />
                                            </Border>
                                            <TextBlock
                                                Foreground="{DynamicResource TextWhiteBrush}"
                                                Text="{Binding SelectedGame.CriticScore}"
                                                TextAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style BasedOn="{StaticResource TextBlockAltBoldBaseStyle}" TargetType="TextBlock">
                                                        <Setter Property="Margin" Value="-34,5,0,0" />
                                                        <Setter Property="FontSize" Value="22" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="100">
                                                                <Setter Property="Margin" Value="-35,8,0,0" />
                                                                <Setter Property="FontSize" Value="17" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Margin="20,0,0,0" Orientation="Horizontal">
                                            <Border
                                                MaxHeight="30"
                                                Background="#AA000000"
                                                BorderBrush="{DynamicResource TextAltBrush}"
                                                BorderThickness="2"
                                                CornerRadius="5"
                                                Visibility="Collapsed">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Margin" Value="20,0,0,0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedGame.ReleaseYear}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock
                                                        x:Name="ReleaseYearText"
                                                        Margin="3,2,3,0"
                                                        FontSize="20"
                                                        Style="{DynamicResource TextBlockBaseStyleAlt}"
                                                        Text="{Binding SelectedGame.ReleaseYear}"
                                                        TextAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!--  STORE FILTERS BAR (HIDDEN - will be in settings menu later)  -->


                            <!--  STORE GAME DETAILS OVERLAY  -->
                            <StackPanel
                                x:Name="Store_LogoContainer"
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Margin="80,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Panel.ZIndex="-45"
                                Orientation="Vertical">

                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Opacity" Value="0" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=Store_Id, Path=Opacity}" Value="1" />
                                                    <Condition Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True" />
                                                    <Condition Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ThicknessAnimation
                                                                BeginTime="0:0:0.1"
                                                                Storyboard.TargetProperty="Margin"
                                                                From="80,100,0,0"
                                                                Duration="0:0:0.25">
                                                                <ThicknessAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </ThicknessAnimation.EasingFunction>
                                                            </ThicknessAnimation>
                                                            <DoubleAnimation
                                                                BeginTime="0:0:0.1"
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="1"
                                                                Duration="0:0:0.25" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ThicknessAnimation
                                                                Storyboard.TargetProperty="Margin"
                                                                To="80,0,0,0"
                                                                Duration="0:0:0">
                                                                <ThicknessAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </ThicknessAnimation.EasingFunction>
                                                            </ThicknessAnimation>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="0"
                                                                Duration="0:0:0" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                            <!--  SAFE CHECK: Hides if game is null (No converter needed)  -->
                                            <DataTrigger Binding="{Binding Content.SelectedGame, ElementName=StoreDataBridge}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!--  THE GAME LOGO  -->
                                <Image
                                    MaxWidth="600"
                                    MaxHeight="140"
                                    Margin="0,0,0,16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    RenderOptions.BitmapScalingMode="Fant"
                                    Source="{Binding Content.SelectedGame.LogoImageBitmap, ElementName=StoreDataBridge}"
                                    Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Content.SelectedGame.HasLogo, ElementName=StoreDataBridge}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <!--  FALLBACK TEXT TITLE  -->
                                <StackPanel x:Name="Store_AdditionalGameTitlePanel" MaxWidth="800">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="0" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Content.SelectedGame.HasLogo, ElementName=StoreDataBridge}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=Store_Id, Path=Opacity}" Value="1" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    BeginTime="0:0:0.15"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="1"
                                                                    Duration="0:0:0.25" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="0"
                                                                    Duration="0:0:0" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock
                                        MaxHeight="120"
                                        FontSize="46"
                                        Style="{DynamicResource TextBlockBoldBaseStyle}"
                                        Text="{Binding Content.SelectedGame.DisplayName, ElementName=StoreDataBridge}"
                                        TextAlignment="Left"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <!--  METADATA & ACTIONS  -->
                                <StackPanel x:Name="Store_AdditionalGameDetailsPanel" Orientation="Vertical">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=Store_Id, Path=Opacity}" Value="1" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    BeginTime="0:0:0.15"
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="1"
                                                                    Duration="0:0:0.25" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    To="0"
                                                                    Duration="0:0:0" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!--  RATINGS & RELEASE DATA BAR  -->
                                    <StackPanel Margin="0,15,0,0" Orientation="Horizontal">
                                        <StackPanel Margin="0,0,20,0" Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Content.SelectedGame.HasPlatformIcon, ElementName=StoreDataBridge}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Image
                                                MaxHeight="30"
                                                RenderOptions.BitmapScalingMode="Fant"
                                                Source="{Binding Content.SelectedGame.PlatformIcon, ElementName=StoreDataBridge}" />
                                        </StackPanel>

                                        <StackPanel
                                            Margin="0,0,20,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Content.SelectedGame.Rating, ElementName=StoreDataBridge}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Border
                                                Width="34"
                                                Height="34"
                                                Background="#FFB32B"
                                                BorderThickness="0"
                                                CornerRadius="5">
                                                <TextBlock
                                                    Margin="0,5,0,0"
                                                    FontSize="1"
                                                    Style="{DynamicResource TextBlockGameScore}"
                                                    Text="{Binding Content.SelectedGame.Rating, ElementName=StoreDataBridge, StringFormat={}{0:F0}}"
                                                    TextAlignment="Center"
                                                    Visibility="Hidden" />
                                            </Border>
                                            <TextBlock
                                                Margin="-34,5,0,0"
                                                FontFamily="Lato Bold"
                                                FontSize="22"
                                                Foreground="White"
                                                Text="{Binding Content.SelectedGame.Rating, ElementName=StoreDataBridge, StringFormat={}{0:F0}}"
                                                TextAlignment="Center" />
                                        </StackPanel>

                                        <Border
                                            Padding="8,2"
                                            Background="#AA000000"
                                            BorderThickness="2"
                                            CornerRadius="5">
                                            <TextBlock
                                                FontSize="20"
                                                Style="{DynamicResource TextBlockBaseStyleAlt}"
                                                Text="{Binding Content.SelectedGame.ReleaseYearLabel, ElementName=StoreDataBridge}" />
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Content.SelectedGame.ReleaseYearLabel, ElementName=StoreDataBridge}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </StackPanel>

                                    <!--  METADATA DATA BAR: Genres, Devs, Pubs  -->
                                    <StackPanel Margin="0,15,0,0" Orientation="Vertical">
                                        <TextBlock
                                            Margin="0,0,0,5"
                                            FontSize="18"
                                            Foreground="#E0FFFFFF"
                                            Text="{Binding Content.SelectedGame.GenresDisplay, ElementName=StoreDataBridge, StringFormat='{}Genres: {0}'}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,25,0"
                                                FontSize="16"
                                                Foreground="#B0FFFFFF"
                                                Text="{Binding Content.SelectedGame.DevelopersDisplay, ElementName=StoreDataBridge, StringFormat='{}Developer: {0}'}" />
                                            <TextBlock
                                                FontSize="16"
                                                Foreground="#B0FFFFFF"
                                                Text="{Binding Content.SelectedGame.PublishersDisplay, ElementName=StoreDataBridge, StringFormat='{}Publisher: {0}'}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  SUMMARY  -->
                                    <TextBlock
                                        MaxWidth="700"
                                        MaxHeight="80"
                                        Margin="0,12,0,0"
                                        FontSize="17"
                                        Foreground="#CCFFFFFF"
                                        LineHeight="22"
                                        Text="{Binding Content.SelectedGame.Summary, ElementName=StoreDataBridge}"
                                        TextTrimming="WordEllipsis"
                                        TextWrapping="Wrap" />

                                    <!--  Screenshots card  -->
                                    <Button
                                        x:Name="ScreenshotCard"
                                        Width="280"
                                        Height="158"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        Background="#33000000"
                                        BorderThickness="0"
                                        Command="{Binding Content.OpenScreenshotViewerCommand, ElementName=StoreDataBridge}"
                                        Cursor="Hand"
                                        FocusVisualStyle="{x:Null}"
                                        OverridesDefaultStyle="True">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Content.HasScreenshots, ElementName=StoreDataBridge}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Border
                                                        x:Name="CardBackground"
                                                        Background="#33000000"
                                                        BorderThickness="0"
                                                        CornerRadius="8">
                                                        <Border.Clip>
                                                            <RectangleGeometry
                                                                RadiusX="8"
                                                                RadiusY="8"
                                                                Rect="0,0,280,158" />
                                                        </Border.Clip>
                                                        <Grid>
                                                            <Image
                                                                RenderOptions.BitmapScalingMode="Fant"
                                                                Source="{Binding Content.SelectedGame.Screenshots[0].Url, ElementName=StoreDataBridge}"
                                                                Stretch="UniformToFill" />
                                                            <Border
                                                                Margin="0,0,8,8"
                                                                Padding="10,5"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Background="#CC000000"
                                                                CornerRadius="6">
                                                                <TextBlock
                                                                    FontSize="16"
                                                                    Foreground="White"
                                                                    Text="{Binding Content.ScreenshotCount, ElementName=StoreDataBridge, StringFormat='+{0}'}" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <Border
                                                        x:Name="MainBorder"
                                                        Margin="-3"
                                                        BorderThickness="3"
                                                        CornerRadius="11"
                                                        Opacity="0"
                                                        Style="{DynamicResource AnimatedBorderBrush}"
                                                        Tag="False"
                                                        Visibility="Collapsed" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="MainBorder" Property="Tag" Value="True" />
                                                        <Setter TargetName="MainBorder" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="CardBackground" Property="Opacity" Value="0.9" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <MediaElement
                                        Width="280"
                                        Height="158"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0"
                                        LoadedBehavior="Play"
                                        UnloadedBehavior="Stop"
                                        Volume="0.5"
                                        Stretch="UniformToFill"
                                        Source="{Binding Content.ResolvedTrailerUrl, ElementName=StoreDataBridge}"
                                        Visibility="{Binding Content.HasResolvedTrailer, ElementName=StoreDataBridge, Converter={StaticResource BoolToVis}}" />

                                </StackPanel>
                            </StackPanel>
                            <Grid Visibility="Collapsed">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="Grid.Row" Value="4" />
                                        <Setter Property="Grid.ColumnSpan" Value="3" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=PART_MainHost, Path=Visibility}" Value="Visible">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                BeginTime="0:0:1"
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="1"
                                                                Duration="0:0:0.5" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Rectangle
                                    Width="{Binding ActualWidth, ElementName=PART_ViewHost}"
                                    Height="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Fill="{DynamicResource TextAltBrush}"
                                    Opacity="0.4" />
                                <FilterPresetSelector
                                    x:Name="ItemsFilterPresets"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Center"
                                    FocusVisualStyle="{x:Null}" />
                            </Grid>

                            <Grid
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                VerticalAlignment="Center">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=Id, Path=Opacity}" Value="1" />
                                                    <Condition Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                BeginTime="0:0:0.6"
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="1"
                                                                Duration="0:0:1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="0"
                                                                Duration="0:0:0" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Visibility="Collapsed">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource TextBlockAltBaseStyle}" TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#BFEAD3CF" />
                                            <Setter Property="FontSize" Value="34" />
                                            <Setter Property="Margin" Value="80,0,30,0" />
                                            <Setter Property="TextTrimming" Value="WordEllipsis" />
                                            <Setter Property="Text" Value="{Binding SelectedGame.Genres, Converter={StaticResource ListToStringConverter}, ConverterParameter='  |  '}" />
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Grid Panel.ZIndex="1" FocusVisualStyle="{x:Null}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="VerticalAlignment" Value="Top" />
                                        <Setter Property="Grid.Row" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="3" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=PART_MainHost, Path=Visibility}" Value="Visible">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                BeginTime="0:0:1"
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="1"
                                                                Duration="0:0:0.5" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Margin" Value="20,30,0,30" />
                                            <Style.Triggers />
                                        </Style>
                                    </StackPanel.Style>
                                    <Image
                                        x:Name="FilterPresetLogo"
                                        RenderOptions.BitmapScalingMode="Fant"
                                        Source="{ThemeFileBinding ActiveFilterPreset.Name,
                                                                  PathFormat='Icons/Filter/{0}.png'}"
                                        Stretch="Uniform">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Source}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ElementName=FilterPresetIcon, Path=Visibility}" Value="Visible">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <Image
                                        x:Name="FilterPresetLogoAlternative"
                                        RenderOptions.BitmapScalingMode="Fant"
                                        Source="{ThemeFileBinding ActiveFilterPreset.Name,
                                                                  PathFormat='Icons/Filter_White/{0}.png'}"
                                        Stretch="Uniform">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Source}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ElementName=FilterPresetLogo, Path=Visibility}" Value="Visible">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ElementName=FilterPresetIcon, Path=Visibility}" Value="Visible">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            x:Name="FilterPresetIcon"
                                            RenderOptions.BitmapScalingMode="Fant"
                                            RenderTransformOrigin="0.5,0.5"
                                            Source="{ThemeFileBinding ActiveFilterPreset.Name,
                                                                      PathFormat='Icons/Filter_Icon/{0}.png'}"
                                            Stretch="Uniform">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Margin" Value="0,0,0,0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Source}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock
                                            x:Name="FilterPresetIconText"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Lato Bold"
                                            Foreground="{DynamicResource TextWhiteBrush}"
                                            Text="{Binding ActiveFilterPreset.Name}"
                                            TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Margin" Value="15,0,0,0" />
                                                    <Setter Property="FontSize" Value="28" />
                                                    <Setter Property="TextWrapping" Value="WrapWithOverflow" />
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding ElementName=FilterPresetIcon, Path=Visibility}" Value="Visible" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="FilterPresetText"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Lato Bold"
                                        Foreground="{DynamicResource TextWhiteBrush}"
                                        Text="{Binding ActiveFilterPreset.Name}"
                                        TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="Margin" Value="0,0,0,0" />
                                                <Setter Property="FontSize" Value="28" />
                                                <Setter Property="TextWrapping" Value="WrapWithOverflow" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=FilterPresetLogo, Path=Source}" Value="{x:Null}" />
                                                            <Condition Binding="{Binding ElementName=FilterPresetLogoAlternative, Path=Source}" Value="{x:Null}" />
                                                            <Condition Binding="{Binding ElementName=FilterPresetIcon, Path=Source}" Value="{x:Null}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <DockPanel>
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Margin" Value="0,0,0,0" />
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="Grid.Row" Value="2" />
                                        <Setter Property="Grid.RowSpan" Value="2" />
                                        <Setter Property="Grid.ColumnSpan" Value="3" />
                                        <Style.Triggers>
                                            <!--  Hide Native DockPanel fully when store is open  -->
                                            <DataTrigger Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=PART_ViewHost, Path=Visibility}" Value="Visible">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                BeginTime="0:0:0.8"
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="1"
                                                                Duration="0:0:1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="False">
                                                <Setter Property="Grid.Row" Value="1" />
                                                <Setter Property="Grid.RowSpan" Value="3" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <!--  NATIVE GAMES LIST  -->
                                <ListBoxEx
                                    x:Name="PART_ListGameItems"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    FocusVisualStyle="{x:Null}"
                                    KeyboardNavigation.DirectionalNavigation="Once"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    VirtualizingStackPanel.IsVirtualizing="True" />
                            </DockPanel>

                            <!--  STORE HORIZONTAL GAMES LIST  -->
                            <ListBoxEx
                                x:Name="Store_ListGameItems"
                                Grid.Row="2"
                                Grid.RowSpan="2"
                                Grid.ColumnSpan="3"
                                Margin="20,0,0,30"
                                VerticalAlignment="Bottom"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                FocusVisualStyle="{x:Null}"
                                ItemsSource="{Binding Content.Games, ElementName=StoreDataBridge}"
                                KeyboardNavigation.DirectionalNavigation="Once"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                SelectedItem="{Binding Content.SelectedGame, ElementName=StoreDataBridge, Mode=TwoWay}"
                                VirtualizingStackPanel.IsVirtualizing="True">
                                <ListBoxEx.Style>
                                    <Style TargetType="ListBoxEx">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxEx">
                                                    <ScrollViewer
                                                        CanContentScroll="True"
                                                        ClipToBounds="False"
                                                        Focusable="False"
                                                        HorizontalScrollBarVisibility="Hidden"
                                                        VerticalScrollBarVisibility="Disabled">
                                                        <ItemsPresenter ClipToBounds="False" />
                                                    </ScrollViewer>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True" />
                                                    <Condition Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBoxEx.Style>

                                <ListBoxEx.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel
                                            IsItemsHost="True"
                                            Orientation="Horizontal"
                                            VirtualizingPanel.ScrollUnit="Item" />
                                    </ItemsPanelTemplate>
                                </ListBoxEx.ItemsPanel>

                                <!--  INLINED NATIVE CONTAINER STYLE  -->
                                <ListBoxEx.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Grid
                                                        Width="150"
                                                        Height="215"
                                                        Margin="14,16,14,16"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        RenderTransformOrigin="0.5,0.5">
                                                        <Grid.RenderTransform>
                                                            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                                                        </Grid.RenderTransform>
                                                        <ContentPresenter />
                                                        <Border
                                                            x:Name="FlashFocus"
                                                            CornerRadius="8"
                                                            Opacity="0"
                                                            Style="{DynamicResource AnimatedFlashFocus}"
                                                            Tag="False"
                                                            Visibility="Collapsed" />
                                                        <Border
                                                            x:Name="FlashCover"
                                                            CornerRadius="8"
                                                            Opacity="0"
                                                            Style="{DynamicResource AnimatedFlashCover}"
                                                            Tag="False"
                                                            Visibility="Collapsed" />
                                                        <Border
                                                            x:Name="GameTitleBackground"
                                                            Height="120"
                                                            VerticalAlignment="Bottom"
                                                            Background="{DynamicResource GameTitleBrush}"
                                                            CornerRadius="8"
                                                            Opacity="0.6"
                                                            Visibility="Collapsed" />
                                                        <Border
                                                            x:Name="MainBorder"
                                                            BorderThickness="2"
                                                            CornerRadius="8"
                                                            Opacity="0"
                                                            Style="{DynamicResource AnimatedBorderBrush}"
                                                            Tag="False"
                                                            Visibility="Collapsed" />
                                                        <StackPanel
                                                            Margin="12,15"
                                                            VerticalAlignment="Bottom"
                                                            Panel.ZIndex="1">
                                                            <TextBlock
                                                                x:Name="GameTitle"
                                                                Margin="0,6,0,0"
                                                                FontSize="{DynamicResource FontSizeSmall}"
                                                                Style="{DynamicResource TextBlockBaseStyle}"
                                                                Text="{Binding DisplayName}"
                                                                TextAlignment="Left"
                                                                TextTrimming="WordEllipsis"
                                                                Visibility="Collapsed" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetName="CardScale"
                                                                            Storyboard.TargetProperty="ScaleX"
                                                                            To="1.15"
                                                                            Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetName="CardScale"
                                                                            Storyboard.TargetProperty="ScaleY"
                                                                            To="1.15"
                                                                            Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetName="CardScale"
                                                                            Storyboard.TargetProperty="ScaleX"
                                                                            To="1"
                                                                            Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetName="CardScale"
                                                                            Storyboard.TargetProperty="ScaleY"
                                                                            To="1"
                                                                            Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.ExitActions>
                                                        </Trigger>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter TargetName="FlashFocus" Property="Tag" Value="True" />
                                                            <Setter TargetName="FlashCover" Property="Tag" Value="True" />
                                                            <Setter TargetName="MainBorder" Property="Tag" Value="True" />
                                                            <Setter TargetName="MainBorder" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="FlashFocus" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="FlashCover" Property="Visibility" Value="Visible" />
                                                            <Setter Property="Canvas.ZIndex" Value="90" />
                                                        </Trigger>
                                                        <Trigger Property="IsFocused" Value="False">
                                                            <Setter TargetName="FlashFocus" Property="Tag" Value="False" />
                                                            <Setter TargetName="FlashCover" Property="Tag" Value="False" />
                                                            <Setter TargetName="MainBorder" Property="Tag" Value="False" />
                                                            <Setter TargetName="MainBorder" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="FlashFocus" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="FlashCover" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="GameTitleBackground" Property="Opacity" Value="0.3" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Settings Fullscreen.ShowGameTitles}" Value="True">
                                                            <Setter TargetName="GameTitleBackground" Property="Opacity" Value="0.9" />
                                                            <Setter TargetName="GameTitleBackground" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="GameTitle" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBoxEx.ItemContainerStyle>

                                <!--  INLINED NATIVE CARD TEMPLATE  -->
                                <ListBoxEx.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="150" Height="215">
                                            <Border
                                                x:Name="Mask"
                                                Background="Black"
                                                BorderThickness="0"
                                                CornerRadius="8" />
                                            <Image
                                                x:Name="PART_ImageCover"
                                                RenderOptions.BitmapScalingMode="Fant"
                                                Source="{Binding CoverImageBitmap}"
                                                Stretch="{Settings CoverArtStretch}"
                                                StretchDirection="Both" />

                                            <!--  Metadata Overlay  -->
                                            <Border
                                                Padding="6,4"
                                                VerticalAlignment="Bottom"
                                                Background="#CC000000"
                                                CornerRadius="0,0,8,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Image
                                                        Grid.Column="0"
                                                        MaxHeight="14"
                                                        Margin="0,0,6,0"
                                                        HorizontalAlignment="Left"
                                                        RenderOptions.BitmapScalingMode="Fant"
                                                        Source="{Binding PlatformIcon}">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasPlatformIcon}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>

                                                    <StackPanel
                                                        Grid.Column="2"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Rating}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock
                                                            Margin="0,0,2,1"
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            Foreground="#FFD700"
                                                            Text="★" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontFamily="Lato Bold"
                                                            FontSize="12"
                                                            Foreground="White"
                                                            Text="{Binding Rating, StringFormat={}{0:F1}}" />
                                                    </StackPanel>

                                                    <TextBlock
                                                        Grid.Column="3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Lato Bold"
                                                        FontSize="12"
                                                        Foreground="White"
                                                        Text="{Binding ReleaseYearLabel}" />
                                                </Grid>
                                            </Border>

                                            <Grid.OpacityMask>
                                                <VisualBrush
                                                    RenderOptions.BitmapScalingMode="Fant"
                                                    Stretch="Fill"
                                                    Visual="{Binding ElementName=Mask}" />
                                            </Grid.OpacityMask>
                                        </Grid>
                                    </DataTemplate>
                                </ListBoxEx.ItemTemplate>
                            </ListBoxEx>

                            <!--  STORE SPLIT LAYOUT (grid + details when ChangeViewButton is toggled)  -->
                            <Grid
                                x:Name="Store_SplitLayout"
                                Grid.Row="1"
                                Grid.RowSpan="3"
                                Grid.ColumnSpan="3"
                                Panel.ZIndex="-44">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True" />
                                                    <Condition Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="300" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="500" />
                                </Grid.ColumnDefinitions>

                                <!--  LEFT: Game grid (rows + columns)  -->
                                <ListBoxEx
                                    x:Name="Store_GridGameItems"
                                    Margin="10,10,5,10"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    FocusVisualStyle="{x:Null}"
                                    ItemsSource="{Binding Content.Games, ElementName=StoreDataBridge}"
                                    KeyboardNavigation.DirectionalNavigation="Once"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    SelectedItem="{Binding Content.SelectedGame, ElementName=StoreDataBridge, Mode=TwoWay}"
                                    VirtualizingStackPanel.IsVirtualizing="False">
                                    <ListBoxEx.Style>
                                        <Style TargetType="ListBoxEx">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxEx">
                                                        <ScrollViewer
                                                            CanContentScroll="False"
                                                            ClipToBounds="False"
                                                            Focusable="False"
                                                            HorizontalScrollBarVisibility="Hidden"
                                                            VerticalScrollBarVisibility="Auto">
                                                            <ItemsPresenter ClipToBounds="False" />
                                                        </ScrollViewer>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBoxEx.Style>
                                    <ListBoxEx.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBoxEx.ItemsPanel>
                                    <ListBoxEx.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Grid
                                                            Width="120"
                                                            Height="172"
                                                            Margin="8,12,8,12"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            RenderTransformOrigin="0.5,0.5">
                                                            <Grid.RenderTransform>
                                                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                                                            </Grid.RenderTransform>
                                                            <ContentPresenter />
                                                            <Border
                                                                x:Name="FlashFocus"
                                                                CornerRadius="8"
                                                                Opacity="0"
                                                                Style="{DynamicResource AnimatedFlashFocus}"
                                                                Tag="False"
                                                                Visibility="Collapsed" />
                                                            <Border
                                                                x:Name="FlashCover"
                                                                CornerRadius="8"
                                                                Opacity="0"
                                                                Style="{DynamicResource AnimatedFlashCover}"
                                                                Tag="False"
                                                                Visibility="Collapsed" />
                                                            <Border
                                                                x:Name="MainBorder"
                                                                BorderThickness="2"
                                                                CornerRadius="8"
                                                                Opacity="0"
                                                                Style="{DynamicResource AnimatedBorderBrush}"
                                                                Tag="False"
                                                                Visibility="Collapsed" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation
                                                                                Storyboard.TargetName="CardScale"
                                                                                Storyboard.TargetProperty="ScaleX"
                                                                                To="1.15"
                                                                                Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation
                                                                                Storyboard.TargetName="CardScale"
                                                                                Storyboard.TargetProperty="ScaleY"
                                                                                To="1.15"
                                                                                Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation
                                                                                Storyboard.TargetName="CardScale"
                                                                                Storyboard.TargetProperty="ScaleX"
                                                                                To="1"
                                                                                Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation
                                                                                Storyboard.TargetName="CardScale"
                                                                                Storyboard.TargetProperty="ScaleY"
                                                                                To="1"
                                                                                Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                            <Trigger Property="IsFocused" Value="True">
                                                                <Setter TargetName="FlashFocus" Property="Tag" Value="True" />
                                                                <Setter TargetName="FlashCover" Property="Tag" Value="True" />
                                                                <Setter TargetName="MainBorder" Property="Tag" Value="True" />
                                                                <Setter TargetName="MainBorder" Property="Visibility" Value="Visible" />
                                                                <Setter TargetName="FlashFocus" Property="Visibility" Value="Visible" />
                                                                <Setter TargetName="FlashCover" Property="Visibility" Value="Visible" />
                                                                <Setter Property="Canvas.ZIndex" Value="90" />
                                                            </Trigger>
                                                            <Trigger Property="IsFocused" Value="False">
                                                                <Setter TargetName="FlashFocus" Property="Tag" Value="False" />
                                                                <Setter TargetName="FlashCover" Property="Tag" Value="False" />
                                                                <Setter TargetName="MainBorder" Property="Tag" Value="False" />
                                                                <Setter TargetName="MainBorder" Property="Visibility" Value="Collapsed" />
                                                                <Setter TargetName="FlashFocus" Property="Visibility" Value="Collapsed" />
                                                                <Setter TargetName="FlashCover" Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBoxEx.ItemContainerStyle>
                                    <ListBoxEx.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="120" Height="172">
                                                <Border
                                                    x:Name="Mask"
                                                    Background="Black"
                                                    BorderThickness="0"
                                                    CornerRadius="8" />
                                                <Image
                                                    RenderOptions.BitmapScalingMode="Fant"
                                                    Source="{Binding CoverImageBitmap}"
                                                    Stretch="{Settings CoverArtStretch}"
                                                    StretchDirection="Both" />
                                                <Grid.OpacityMask>
                                                    <VisualBrush
                                                        RenderOptions.BitmapScalingMode="Fant"
                                                        Stretch="Fill"
                                                        Visual="{Binding ElementName=Mask}" />
                                                </Grid.OpacityMask>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBoxEx.ItemTemplate>
                                </ListBoxEx>

                                <!--  SPLITTER  -->
                                <GridSplitter
                                    Grid.Column="1"
                                    Width="4"
                                    Margin="0,10"
                                    Background="#44FFFFFF"
                                    Focusable="False"
                                    ResizeBehavior="PreviousAndNext"
                                    ResizeDirection="Columns" />

                                <!--  RIGHT: Game details panel  -->
                                <ScrollViewer
                                    Grid.Column="2"
                                    Margin="5,10,10,10"
                                    Focusable="False"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <StackPanel Orientation="Vertical">

                                        <!--  Logo  -->
                                        <Image
                                            MaxWidth="460"
                                            MaxHeight="100"
                                            Margin="0,0,0,14"
                                            HorizontalAlignment="Left"
                                            RenderOptions.BitmapScalingMode="Fant"
                                            Source="{Binding Content.SelectedGame.LogoImageBitmap, ElementName=StoreDataBridge}"
                                            Stretch="Uniform">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Content.SelectedGame.HasLogo, ElementName=StoreDataBridge}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!--  Fallback title (when no logo)  -->
                                        <TextBlock
                                            MaxHeight="100"
                                            FontSize="34"
                                            Text="{Binding Content.SelectedGame.DisplayName, ElementName=StoreDataBridge}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource TextBlockBoldBaseStyle}" TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Content.SelectedGame.HasLogo, ElementName=StoreDataBridge}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!--  Metadata bar: platform icon, rating, release year  -->
                                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                            <StackPanel Margin="0,0,15,0" Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Content.SelectedGame.HasPlatformIcon, ElementName=StoreDataBridge}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Image
                                                    MaxHeight="26"
                                                    RenderOptions.BitmapScalingMode="Fant"
                                                    Source="{Binding Content.SelectedGame.PlatformIcon, ElementName=StoreDataBridge}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,15,0" Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Content.SelectedGame.Rating, ElementName=StoreDataBridge}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Border
                                                    Width="30"
                                                    Height="30"
                                                    Background="#FFB32B"
                                                    BorderThickness="0"
                                                    CornerRadius="5">
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        FontSize="1"
                                                        Style="{DynamicResource TextBlockGameScore}"
                                                        Text="{Binding Content.SelectedGame.Rating, ElementName=StoreDataBridge, StringFormat={}{0:F0}}"
                                                        TextAlignment="Center"
                                                        Visibility="Hidden" />
                                                </Border>
                                                <TextBlock
                                                    Margin="-30,4,0,0"
                                                    FontFamily="Lato Bold"
                                                    FontSize="20"
                                                    Foreground="White"
                                                    Text="{Binding Content.SelectedGame.Rating, ElementName=StoreDataBridge, StringFormat={}{0:F0}}" />
                                            </StackPanel>

                                            <Border
                                                Padding="6,2"
                                                Background="#AA000000"
                                                BorderThickness="2"
                                                CornerRadius="5">
                                                <TextBlock
                                                    FontSize="18"
                                                    Style="{DynamicResource TextBlockBaseStyleAlt}"
                                                    Text="{Binding Content.SelectedGame.ReleaseYearLabel, ElementName=StoreDataBridge}" />
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Content.SelectedGame.ReleaseYearLabel, ElementName=StoreDataBridge}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </StackPanel>

                                        <!--  Genres / Developers / Publishers  -->
                                        <StackPanel Margin="0,14,0,0" Orientation="Vertical">
                                            <TextBlock
                                                Margin="0,0,0,4"
                                                FontSize="16"
                                                Foreground="#E0FFFFFF"
                                                Text="{Binding Content.SelectedGame.GenresDisplay, ElementName=StoreDataBridge, StringFormat='{}Genres: {0}'}"
                                                TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    Margin="0,0,20,0"
                                                    FontSize="14"
                                                    Foreground="#B0FFFFFF"
                                                    Text="{Binding Content.SelectedGame.DevelopersDisplay, ElementName=StoreDataBridge, StringFormat='{}Developer: {0}'}" />
                                                <TextBlock
                                                    FontSize="14"
                                                    Foreground="#B0FFFFFF"
                                                    Text="{Binding Content.SelectedGame.PublishersDisplay, ElementName=StoreDataBridge, StringFormat='{}Publisher: {0}'}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!--  Summary  -->
                                        <TextBlock
                                            MaxWidth="460"
                                            MaxHeight="120"
                                            Margin="0,10,0,0"
                                            FontSize="15"
                                            Foreground="#CCFFFFFF"
                                            LineHeight="20"
                                            Text="{Binding Content.SelectedGame.Summary, ElementName=StoreDataBridge}"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="Wrap" />

                                        <!--  Screenshots card  -->
                                        <Button
                                            Width="260"
                                            Height="146"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Left"
                                            Background="#33000000"
                                            BorderThickness="0"
                                            Command="{Binding Content.OpenScreenshotViewerCommand, ElementName=StoreDataBridge}"
                                            Cursor="Hand"
                                            FocusVisualStyle="{x:Null}"
                                            OverridesDefaultStyle="True">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Content.HasScreenshots, ElementName=StoreDataBridge}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Border
                                                            x:Name="CardBackground"
                                                            Background="#33000000"
                                                            BorderThickness="0"
                                                            CornerRadius="8">
                                                            <Border.Clip>
                                                                <RectangleGeometry
                                                                    RadiusX="8"
                                                                    RadiusY="8"
                                                                    Rect="0,0,260,146" />
                                                            </Border.Clip>
                                                            <Grid>
                                                                <Image
                                                                    RenderOptions.BitmapScalingMode="Fant"
                                                                    Source="{Binding Content.SelectedGame.Screenshots[0].Url, ElementName=StoreDataBridge}"
                                                                    Stretch="UniformToFill" />
                                                                <Border
                                                                    Margin="0,0,8,8"
                                                                    Padding="10,5"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Bottom"
                                                                    Background="#CC000000"
                                                                    CornerRadius="6">
                                                                    <TextBlock
                                                                        FontSize="16"
                                                                        Foreground="White"
                                                                        Text="{Binding Content.ScreenshotCount, ElementName=StoreDataBridge, StringFormat='+{0}'}" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <Border
                                                            x:Name="MainBorder"
                                                            Margin="-3"
                                                            BorderThickness="3"
                                                            CornerRadius="11"
                                                            Opacity="0"
                                                            Style="{DynamicResource AnimatedBorderBrush}"
                                                            Tag="False"
                                                            Visibility="Collapsed" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter TargetName="MainBorder" Property="Tag" Value="True" />
                                                            <Setter TargetName="MainBorder" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="CardBackground" Property="Opacity" Value="0.9" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <MediaElement
                                            Width="260"
                                            Height="146"
                                            HorizontalAlignment="Left"
                                            Margin="0,12,0,0"
                                            LoadedBehavior="Play"
                                            UnloadedBehavior="Stop"
                                            Volume="0.5"
                                            Stretch="UniformToFill"
                                            Source="{Binding Content.ResolvedTrailerUrl, ElementName=StoreDataBridge}"
                                             Visibility="{Binding Content.HasResolvedTrailer, ElementName=StoreDataBridge, Converter={StaticResource BoolToVis}}" />
                                         <TextBlock Text="{Binding Content.ResolvedTrailerUrl, ElementName=StoreDataBridge, TargetNullValue='(no trailer)'}" Foreground="Red" FontSize="10" TextWrapping="Wrap" />
   
                                          <TextBlock Text="{Binding Content.ResolvedTrailerUrl, ElementName=StoreDataBridge, TargetNullValue='(no trailer)'}" Foreground="Red" FontSize="10" TextWrapping="Wrap" />

                                    </StackPanel>
                                </ScrollViewer>

                            </Grid>

                            <TextBlock
                                Grid.RowSpan="5"
                                Grid.ColumnSpan="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="40"
                                Text="{DynamicResource LOCNoGamesFound}"
                                TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource TextBlockBaseStyle}" TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,0" />
                                        <Style.Triggers>
                                            <!--  Hide when store is open  -->
                                            <DataTrigger Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=PART_ViewHost, Path=Opacity}" Value="1" />
                                                    <Condition Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0" />
                                                    <Condition Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                BeginTime="0:0:0.5"
                                                                Storyboard.TargetProperty="Opacity"
                                                                From="0"
                                                                To="1"
                                                                Duration="0:0:0.5" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="Opacity"
                                                                From="0"
                                                                To="0"
                                                                Duration="0:0:0" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Panel.ZIndex="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Background" Value="#AB000000" />
                                        <Setter Property="Grid.Row" Value="0" />
                                        <Setter Property="Grid.RowSpan" Value="5" />
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="3" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=PART_ElemFilters, Path=Visibility}" Value="Visible">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=PART_ElemFiltersAdditional, Path=Visibility}" Value="Visible">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=PART_ContentFilterItems, Path=Visibility}" Value="Visible">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Panel.ZIndex="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Background" Value="{DynamicResource FilterOverlayBrush}" />
                                        <Setter Property="Grid.Row" Value="0" />
                                        <Setter Property="Grid.RowSpan" Value="5" />
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="3" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=PART_ElemFilters, Path=Visibility}" Value="Visible">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=PART_ElemFiltersAdditional, Path=Visibility}" Value="Visible">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=PART_ContentFilterItems, Path=Visibility}" Value="Visible">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border
                                Height="70"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Panel.ZIndex="1"
                                Background="{DynamicResource ControlBackgroundDarkBrush}"
                                CornerRadius="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Margin" Value="0,0,20,0" />
                                        <Setter Property="Grid.Row" Value="1" />
                                        <Setter Property="Grid.ColumnSpan" Value="3" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="False">
                                                <Setter Property="Margin" Value="0,20,20,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel
                                    x:Name="PART_ElemProgressIndicator"
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Panel.ZIndex="1"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        x:Name="PART_TextProgressTooltip"
                                        Margin="15,0,15,0"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Style="{DynamicResource TextBlockBaseStyle}">
                                        <TextBlock.Effect>
                                            <DropShadowEffect
                                                BlurRadius="0"
                                                Opacity="0.8"
                                                RenderingBias="Quality"
                                                ShadowDepth="1"
                                                Color="Black" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <ContentControl
                                        Width="38"
                                        Height="38"
                                        Margin="10,0,15,0"
                                        VerticalAlignment="Center"
                                        Focusable="False"
                                        Style="{DynamicResource ProgressIndicator}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Height="50"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Panel.ZIndex="1"
                                Background="{DynamicResource ControlBackgroundDarkBrush}"
                                CornerRadius="10"
                                Visibility="Collapsed">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Margin" Value="0,0,20,20" />
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="Grid.Row" Value="3" />
                                        <Setter Property="Grid.ColumnSpan" Value="3" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=PART_MainHost, Path=Visibility}" Value="Visible">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                BeginTime="0:0:1"
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="1"
                                                                Duration="0:0:0.5" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel
                                    Margin="15,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="20"
                                        Foreground="GhostWhite"
                                        Style="{DynamicResource TextBlockBaseStyle}"
                                        Text="{DynamicResource LOCMetaGameSourceFiltered}" />
                                    <TextBlock
                                        FontSize="20"
                                        Foreground="GhostWhite"
                                        Style="{DynamicResource TextBlockBaseStyle}"
                                        Text=": " />
                                    <TextBlock
                                        Margin="0,0,15,0"
                                        FontSize="20"
                                        Foreground="{DynamicResource GlyphBrush}"
                                        Style="{DynamicResource TextBlockBaseStyle}"
                                        Text="{Binding Items.Count, ElementName=PART_ListGameItems}" />
                                </StackPanel>
                            </Border>

                            <Grid Background="Transparent" Visibility="Collapsed">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Grid.Row" Value="3" />
                                        <Setter Property="Grid.ColumnSpan" Value="3" />
                                        <Style.Triggers>
                                            <!--  Hide native bottom menu when store is open  -->
                                            <DataTrigger Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="3"
                                    Margin="0,0,0,0"
                                    Padding="10"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Background="#30000000"
                                    BorderThickness="0"
                                    CornerRadius="10">
                                    <StackPanel Orientation="Horizontal">
                                        <ButtonEx
                                            x:Name="PART_ButtonInstallL"
                                            Content="{DynamicResource LOCInstallGame}"
                                            Style="{DynamicResource ButtonBottomMenu}" />
                                        <ButtonEx
                                            x:Name="PART_ButtonPlayY"
                                            Content="{DynamicResource LOCPlayGame}"
                                            Style="{DynamicResource ButtonBottomMenu}" />
                                        <ButtonEx
                                            x:Name="PART_ButtonDetailsS"
                                            Content="{DynamicResource LOCGameDetails}"
                                            Style="{DynamicResource ButtonBottomMenu}" />
                                        <ButtonEx
                                            x:Name="PART_ButtonGameOptions"
                                            Content="{DynamicResource LOCGameOptions}"
                                            Style="{DynamicResource ButtonBottomMenu}" />
                                        <CheckBoxEx
                                            x:Name="TrailerToggle"
                                            Width="50"
                                            Height="50"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FocusVisualStyle="{x:Null}"
                                            Focusable="True"
                                            IsChecked="{Binding ElementName=PART_ElemGameDetails, Path=Tag, Mode=TwoWay}">
                                            <CheckBoxEx.Style>
                                                <Style TargetType="CheckBoxEx">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="CheckBoxEx">
                                                                <Border
                                                                    x:Name="BgBorder"
                                                                    Padding="0"
                                                                    Background="Transparent"
                                                                    CornerRadius="5">
                                                                    <TextBlock
                                                                        x:Name="ToggleText"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontFamily="Segoe MDL2 Assets"
                                                                        FontSize="20"
                                                                        Foreground="White"
                                                                        Text="?" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="False">
                                                                        <Setter TargetName="ToggleText" Property="Text" Value="?" />
                                                                        <Setter TargetName="ToggleText" Property="Foreground" Value="#AAAAAA" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsFocused" Value="True">
                                                                        <Setter TargetName="BgBorder" Property="Background" Value="{DynamicResource TextBrush}" />
                                                                        <Setter TargetName="ToggleText" Property="Foreground" Value="{DynamicResource ControlBackgroundBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="BgBorder" Property="Background" Value="#40FFFFFF" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </CheckBoxEx.Style>
                                        </CheckBoxEx>
                                        <ButtonEx
                                            x:Name="PART_ButtonSearch"
                                            Content="{DynamicResource LOCSearchLabel}"
                                            Style="{DynamicResource ButtonBottomMenu}" />
                                        <ButtonEx
                                            x:Name="PART_ButtonFilter"
                                            Content="{DynamicResource LOCFilter}"
                                            Style="{DynamicResource ButtonBottomMenu}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel
                                    x:Name="PART_ElemSearchActive"
                                    Grid.ColumnSpan="2"
                                    Margin="70,20,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Panel.ZIndex="1"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="18"
                                        Style="{DynamicResource TextBlockBaseStyle}"
                                        Text="{DynamicResource LOCGameListSearchResultsS}"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        FontSize="18"
                                        Foreground="White"
                                        Style="{DynamicResource TextBlockBaseStyle}"
                                        Text="{Binding AppSettings.Fullscreen.FilterSettings.Name}"
                                        TextAlignment="Center" />
                                    <StackPanel.Effect>
                                        <DropShadowEffect
                                            BlurRadius="0"
                                            Opacity="0.8"
                                            RenderingBias="Quality"
                                            ShadowDepth="1"
                                            Color="Black" />
                                    </StackPanel.Effect>
                                </StackPanel>
                                <TextBlock
                                    x:Name="PART_ElemExtraFilterActive"
                                    Grid.ColumnSpan="2"
                                    Margin="70,50,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Panel.ZIndex="1"
                                    FontSize="18"
                                    Style="{DynamicResource TextBlockBaseStyle}"
                                    Text="{DynamicResource LOCGameListExtraFilteredD}"
                                    TextAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect
                                            BlurRadius="0"
                                            Opacity="0.8"
                                            RenderingBias="Quality"
                                            ShadowDepth="1"
                                            Color="Black" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <!--  Internal Focus Trackers  -->
                        <StackPanel
                            Grid.Row="0"
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Focusable="False">
                            <TextBlock
                                x:Name="Id"
                                Foreground="Transparent"
                                Text="{Binding SelectedGame.Id, NotifyOnTargetUpdated=True}">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:0" />
                                                <DoubleAnimation
                                                    BeginTime="0:0:0"
                                                    Storyboard.TargetProperty="Opacity"
                                                    From="0"
                                                    To="1"
                                                    Duration="0:0:0.01" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <TextBlock
                                x:Name="Store_Id"
                                Foreground="Transparent"
                                Text="{Binding Content.SelectedGame.Id, ElementName=StoreDataBridge, NotifyOnTargetUpdated=True}">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:0" />
                                                <DoubleAnimation
                                                    BeginTime="0:0:0"
                                                    Storyboard.TargetProperty="Opacity"
                                                    From="0"
                                                    To="1"
                                                    Duration="0:0:0.01" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <TextBlock
                                x:Name="Trigger"
                                Foreground="Transparent"
                                Text="{Binding SelectedGame.Id, NotifyOnTargetUpdated=True}">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:0" />
                                                <DoubleAnimation
                                                    BeginTime="0:0:3"
                                                    Storyboard.TargetProperty="Opacity"
                                                    From="0"
                                                    To="1"
                                                    Duration="0:0:0.1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <TextBlock
                                x:Name="TrailerTrigger"
                                Foreground="Transparent"
                                Text="{Binding SelectedGame.Id, NotifyOnTargetUpdated=True}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ElementName=ChangeViewButton, Path=IsChecked}" Value="True" />
                                                    <Condition Binding="{Binding ElementName=PART_ElemGameDetails, Path=Visibility}" Value="Visible" />
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="Opacity"
                                                                From="1"
                                                                To="0"
                                                                Duration="0:0:0" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                BeginTime="0:0:0"
                                                                Storyboard.TargetProperty="Opacity"
                                                                To="1"
                                                                Duration="0:0:0.3" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!--  Filters  -->
                        <Grid
                            x:Name="FilterGrid"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Focusable" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=ToggleStoreButton, Path=IsChecked}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ElementName=PART_ElemFilters, Path=Visibility}" Value="Visible">
                                            <Setter Property="Focusable" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Filters
                                x:Name="PART_ElemFilters"
                                Margin="0,0,0,0"
                                Focusable="False"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                KeyboardNavigation.TabNavigation="Cycle" />
                            <FiltersAdditional
                                x:Name="PART_ElemFiltersAdditional"
                                Margin="0,0,0,0"
                                Focusable="False"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                KeyboardNavigation.TabNavigation="Cycle" />
                            <ContentControl
                                x:Name="PART_ContentFilterItems"
                                Margin="0,0,0,0"
                                Focusable="False"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                KeyboardNavigation.TabNavigation="Cycle" />
                        </Grid>

                        <GameDetails
                            x:Name="PART_ElemGameDetails"
                            Grid.RowSpan="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Tag="True" />
                        <GameStatus
                            x:Name="PART_ElemGameStatus"
                            Grid.RowSpan="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                        <CheckBoxEx
                            x:Name="MainBackgroundImageButton"
                            Width="50"
                            Height="50"
                            Margin="0,0,0,0"
                            Focusable="False"
                            IsChecked="{Settings Fullscreen.EnableMainBackgroundImage,
                                                 Mode=TwoWay}"
                            Style="{DynamicResource MainBackgroundImageButton}"
                            Visibility="Hidden" />

                        <!--  Updates  -->
                        <MediaElement
                            x:Name="ProgramUpdateChime"
                            MediaElementBehaviors.Repeat="False"
                            Source="{ThemeFile 'audio/ProgramUpdate.mp3'}">
                            <MediaElement.Style>
                                <Style TargetType="MediaElement">
                                    <Setter Property="LoadedBehavior" Value="Manual" />
                                    <Setter Property="UnloadedBehavior" Value="Close" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=PART_ButtonProgramUpdate, Path=Visibility}" Value="Visible">
                                            <Setter Property="LoadedBehavior" Value="Play" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>
                        <MediaElement
                            x:Name="NotificationsChime"
                            MediaElementBehaviors.Repeat="False"
                            Source="{ThemeFile 'audio/Notification.mp3'}">
                            <MediaElement.Style>
                                <Style TargetType="MediaElement">
                                    <Setter Property="LoadedBehavior" Value="Manual" />
                                    <Setter Property="UnloadedBehavior" Value="Close" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=PART_ButtonNotifications, Path=Visibility}" Value="Visible">
                                            <Setter Property="LoadedBehavior" Value="Play" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>

                        <!--  Screenshot Viewer Modal Overlay  -->
                        <Grid
                            Grid.RowSpan="2"
                            Panel.ZIndex="100"
                            Visibility="Collapsed">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Content.IsScreenshotViewerOpen, ElementName=StoreDataBridge}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <!--  Keyboard navigation: ESC to close, arrows to navigate  -->
                            <Grid.InputBindings>
                                <KeyBinding Key="Escape" Command="{Binding Content.CloseScreenshotViewerCommand, ElementName=StoreDataBridge}" />
                                <KeyBinding Key="Left" Command="{Binding Content.PreviousScreenshotCommand, ElementName=StoreDataBridge}" />
                                <KeyBinding Key="Right" Command="{Binding Content.NextScreenshotCommand, ElementName=StoreDataBridge}" />
                            </Grid.InputBindings>

                            <!--  Backdrop  -->
                            <Border Panel.ZIndex="0" Background="#CC000000" />

                            <!--  Close button  -->
                            <Button
                                Width="44"
                                Height="44"
                                Margin="0,20,20,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Panel.ZIndex="10"
                                Command="{Binding Content.CloseScreenshotViewerCommand, ElementName=StoreDataBridge}"
                                Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#44000000" CornerRadius="22">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="24"
                                                Foreground="White"
                                                Text="✕" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!--  Counter  -->
                            <TextBlock
                                Margin="0,24,80,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Panel.ZIndex="10"
                                FontSize="18"
                                Foreground="#AAFFFFFF"
                                Text="{Binding Content.CurrentScreenshotDisplay, ElementName=StoreDataBridge}" />

                            <!--  Left arrow  -->
                            <Button
                                Width="60"
                                Height="60"
                                Margin="30,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Panel.ZIndex="10"
                                Command="{Binding Content.PreviousScreenshotCommand, ElementName=StoreDataBridge}"
                                Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Content.HasPreviousScreenshot, ElementName=StoreDataBridge}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#44000000" CornerRadius="30">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="40"
                                                Foreground="White"
                                                Text="‹" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!--  Right arrow  -->
                            <Button
                                Width="60"
                                Height="60"
                                Margin="0,0,30,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Panel.ZIndex="10"
                                Command="{Binding Content.NextScreenshotCommand, ElementName=StoreDataBridge}"
                                Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Content.HasNextScreenshot, ElementName=StoreDataBridge}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#44000000" CornerRadius="30">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="40"
                                                Foreground="White"
                                                Text="›" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!--  Screenshot image  -->
                            <Viewbox
                                MaxWidth="1600"
                                MaxHeight="900"
                                Stretch="Uniform">
                                <Image
                                    RenderOptions.BitmapScalingMode="Fant"
                                    Source="{Binding Content.CurrentScreenshotUrl, ElementName=StoreDataBridge}"
                                    Stretch="Uniform" />
                            </Viewbox>
                        </Grid>



                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>